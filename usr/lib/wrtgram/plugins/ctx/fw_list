#!/bin/sh

. /usr/lib/wrtgram/common

command="$1"
text="$2"

# Extract firewall rules and format for inline keyboard
firewall=$(uci -q show firewall | grep "@rule" | grep name | grep -oE "\[[[:digit:]]+\].name='([[:graph:]]|[[:blank:]])+'" | awk -F ".name=" '{
    gsub(/[\047]|\[|\]/,"",$1);
    gsub(/[\047]/,"",$2);
    printf "[ {\"callback_data\": \"##CMD##|" $1 "\^" $2 "\" ,\"text\" : \"" $2;
    cmd = "[ \"$(uci -q get firewall.@rule[" $1 "].enabled)\" = \"0\" ] && echo -en \" (Disabled)\" || echo -en \" (Enabled)\"";
    system(cmd);
    print "\"} ],";
}')

# POSIX-compatible string manipulation (replaces bash-specific slicing/substitution)
rules=$(echo "$firewall" | sed 's/,$//')
rls=$(echo "$rules" | sed "s/##CMD##/$command/g")
keyboard="{\"inline_keyboard\": [$rls] }"

# Send the message with the inline keyboard
tg_api_call "sendMessage" \
    -d "chat_id=${WRTGRAM_CHAT_ID}" \
    -d "parse_mode=Markdown" \
    -d "reply_markup=${keyboard}" \
    --data-urlencode "text=${text}"
