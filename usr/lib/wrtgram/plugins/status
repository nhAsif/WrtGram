#!/bin/sh

# ── Uptime & Load ─────────────────────────────────────────────────────────────
UPTIME_RAW=$(uptime)
UPTIME=$(echo "$UPTIME_RAW" | sed -n 's/.*up \([^,]*\), .*/\1/p')
LOAD_AVG=$(echo "$UPTIME_RAW" | sed -n 's/.*load average: \(.*\)/\1/p')

# ── RAM ───────────────────────────────────────────────────────────────────────
MEM_INFO=$(free | grep "Mem:")
TOTAL_MEM=$(echo "$MEM_INFO" | awk '{print $2}')
USED_MEM=$(echo "$MEM_INFO" | awk '{print $3}')
MEM_PERCENT=$((USED_MEM * 100 / TOTAL_MEM))

# ── Disk Usage ("/") ──────────────────────────────────────────────────────────
DISK_INFO=$(df -h / | tail -1)
DISK_USED=$(echo "$DISK_INFO" | awk '{print $3}')
DISK_AVAIL=$(echo "$DISK_INFO" | awk '{print $4}')
DISK_PERCENT=$(echo "$DISK_INFO" | awk '{print $5}')

# ── WAN Uptime ────────────────────────────────────────────────────────────────
WAN_UPTIME_SECS=$(ubus call network.interface.wan status 2>/dev/null \
    | jsonfilter -e "@.uptime" 2>/dev/null)
if [ -n "$WAN_UPTIME_SECS" ] && [ "$WAN_UPTIME_SECS" != "null" ]; then
    WAN_H=$((WAN_UPTIME_SECS / 3600))
    WAN_M=$(( (WAN_UPTIME_SECS % 3600) / 60 ))
    WAN_UPTIME="${WAN_H}h ${WAN_M}m"
else
    WAN_UPTIME="N/A"
fi

# ── CPU Temperature (all thermal zones) ───────────────────────────────────────
TEMP_OUTPUT=""
for zone_file in /sys/class/thermal/thermal_zone*/temp; do
    temp_raw=$(cat "$zone_file" 2>/dev/null)
    if [ -n "$temp_raw" ]; then
        zone_name=$(echo "$zone_file" | grep -oE 'thermal_zone[0-9]+')
        temp_c=$(awk -v t="$temp_raw" 'BEGIN {printf "%.1f°C", t / 1000}')
        TEMP_OUTPUT="${TEMP_OUTPUT}🌡️ *Temp (${zone_name}):* ${temp_c}
"
    fi
done
[ -z "$TEMP_OUTPUT" ] && TEMP_OUTPUT="🌡️ *CPU Temp:* N/A
"

# ── Active Connections ────────────────────────────────────────────────────────
CONN_COUNT=$(wc -l </proc/net/nf_conntrack 2>/dev/null || echo "N/A")

printf "📊 *Router Status*\n\n🕒 *Uptime:* %s\n🌐 *WAN Uptime:* %s\n⚙️ *CPU Load:* %s\n🧠 *RAM:* %s%% used\n💾 *Disk /:* %s used, %s free (%s)\n🔗 *Connections:* %s\n\n%s" \
    "$UPTIME" "$WAN_UPTIME" "$LOAD_AVG" "$MEM_PERCENT" \
    "$DISK_USED" "$DISK_AVAIL" "$DISK_PERCENT" \
    "$CONN_COUNT" "$TEMP_OUTPUT"
