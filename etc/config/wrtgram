config wrtgram 'global'
	option key '[PUT YOUR BOT KEY HERE]'
	option url 'https://api.telegram.org/bot'
	option my_chat_id '[PUT ID OF THE CHAT THAT YOU START WITH BOT]'
	option timeout '60'
	option ignored_macaddrs_file '/etc/wrtgram/macaddr.ignore'
	option openrouter_key '[PUT YOUR OPENROUTER API KEY HERE]'
	option openrouter_model 'meta-llama/llama-3.1-8b-instruct:free'
	option ai_provider 'openrouter'
	option gemini_key '[PUT YOUR GEMINI API KEY HERE]'
	option gemini_model 'gemini-3-flash-preview'

config wrtgram 'smtp'
	option from '[MAIL FROM]'
	option to '[MAIL TO]'

