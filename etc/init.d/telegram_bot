#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2026 OpenWrt.org

START=95
STOP=15

USE_PROCD=1
PROG=/sbin/telegram_bot
CONFIGURATION=wrtgram

start_service () {
    config_load "${CONFIGURATION}"

    procd_open_instance
    # Stay in foreground so procd can manage the process and capture output
    procd_set_param command /usr/bin/env python3 "$PROG"
    procd_set_param file /etc/config/wrtgram
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Procd handles stopping the instance, but we cleanup any stray typing processes
    pids=$(pgrep -f "/sbin/typing" 2>/dev/null)
    [ -n "$pids" ] && kill $pids 2>/dev/null
}
