#!/usr/bin/env python3

import sys, os, subprocess, json, time, re
sys.path.append("/usr/lib/wrtgram")
try:
    import wrtapi
except ImportError:
    sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '../usr/lib/wrtgram')))
    import wrtapi

try:
    with open(f"/proc/{os.getpid()}/comm", "w") as f:
        f.write("telegram_bot")
except:
    pass

var_file = "/var/run/bot_vars"

# Persistent offset
offset = 0
if os.path.exists(var_file):
    with open(var_file, "r") as f:
        content = f.read().strip()
        if content.startswith("offset="):
            try:
                offset = int(content.split("=")[1])
            except ValueError:
                pass

def save_offset(o):
    with open(var_file, "w") as f:
        f.write(f"offset={o}\n")

starting = True
start_time = int(time.time())

wrtapi.log_msg("telegram_bot", "service starting")

if wrtapi.CHAT_ID:
    wrtapi.send_message(wrtapi.CHAT_ID, "🚀 *WrtGram Bot Started*\nSystem is online and ready for commands! Send [/start](/start) to see available commands.")

def getUpdates_api(offset, timeout):
    if not wrtapi.WRTGRAM_API: return None
    cmd = ["curl", "-s"]
    if wrtapi.TLS_INSECURE: cmd.append("-k")
    else: cmd.extend(["--capath", "/etc/ssl/certs"])
    cmd.extend(["-X", "GET", f"{wrtapi.WRTGRAM_API}/getUpdates?offset={offset}&timeout={timeout}"])
    try:
        output = subprocess.check_output(cmd, stderr=subprocess.STDOUT)
        if output: return json.loads(output.decode('utf-8'))
    except: pass
    return None

while True:
    try:
        query_offset = offset + 1 if offset > 0 else ""
        updates = getUpdates_api(query_offset, wrtapi.TIMEOUT)
        
        if not updates or str(updates.get("ok")).lower() != "true":
            wrtapi.log_msg("telegram_bot", "getUpdates failed or empty, retrying in 5s...")
            time.sleep(5)
            continue

        results = updates.get("result", [])
        for res in results:
            update_id = res.get("update_id", 0)
            offset = update_id
            save_offset(offset)
            
            msg_obj = res.get("message")
            cb_obj = res.get("callback_query")
            
            origin = ""
            msg_date = 0
            is_cmd = False
            cmd = ""
            parms = ""
            query_ans = ""
            msg_id_ans = ""
            final_cmd = ""
            
            if msg_obj:
                origin = str(msg_obj.get("chat", {}).get("id", ""))
                msg_date = msg_obj.get("date", 0)
                command_text = msg_obj.get("text", "")
                entities = msg_obj.get("entities", [])
                is_cmd = any(ent.get("type") == "bot_command" for ent in entities)
                
                parts = command_text.split(maxsplit=1)
                cmd = parts[0] if parts else ""
                parms = parts[1] if len(parts) > 1 else ""
                
                if is_cmd:
                    alias_val = wrtapi.get_uci(f"wrtgram.alias.{cmd.lstrip('/')}")
                    if alias_val:
                        aparts = alias_val.split(maxsplit=1)
                        if aparts:
                            cmd = aparts[0]
                            parms = (aparts[1] + " " + parms).strip() if len(aparts) > 1 else parms
                            
                state_file = "/tmp/wrtgram_state.json"
                state = {}
                if os.path.exists(state_file):
                    try:
                        with open(state_file, "r") as f: state = json.load(f)
                    except: pass
                
                origin_state = state.get(origin)
                if is_cmd and origin_state:
                    del state[origin]
                    origin_state = None
                    try:
                        with open(state_file, "w") as f: json.dump(state, f)
                    except: pass
                    
                if not is_cmd and origin_state:
                    cmd = origin_state.get("plugin")
                    parms = command_text
                    is_cmd = True
                
            elif cb_obj:
                origin = str(cb_obj.get("message", {}).get("chat", {}).get("id", ""))
                msg_date = cb_obj.get("message", {}).get("date", 0)
                msg_id_ans = cb_obj.get("message", {}).get("message_id")
                query_ans = cb_obj.get("id")
                final_cmd = cb_obj.get("data", "")
            else:
                continue
                
            if starting and msg_date < start_time:
                continue
                
            if not wrtapi.CHAT_ID or origin != wrtapi.CHAT_ID:
                wrtapi.log_msg("telegram_bot", f"Unauthorized access attempt by ID {origin}")
                if origin:
                    wrtapi.send_message(origin, "This is a private bot.")
                    wrtapi.tg_api_call("leaveChat", form_data={"chat_id": origin})
                continue
                
            typing_proc = subprocess.Popen(["/sbin/typing"])
            
            try:
                if msg_obj and is_cmd:
                    plugin_base = f"/usr/lib/wrtgram/plugins{cmd}"
                    py_plugin = f"{plugin_base}.py"
                    
                    if os.path.exists(py_plugin) or (os.path.exists(plugin_base) and os.path.isfile(plugin_base)):
                        if cmd == "/reboot" and starting:
                            pass
                        else:
                            cwd_path = "/usr/lib/wrtgram/plugins"
                            wrtapi.log_msg("telegram_bot", f"Call {cmd} [{parms}]")
                            
                            parms_sanitized = re.sub(r'["&;<>|\\]+', '', parms)
                            
                            # Select python script natively if exists
                            if os.path.exists(py_plugin):
                                p_args = ["/usr/bin/env", "python3", py_plugin]
                            else:
                                p_args = [plugin_base]
                                
                            if parms_sanitized and not origin_state:
                                p_args.extend(parms_sanitized.split())
                                
                            env = os.environ.copy()
                            if origin_state:
                                env["WRTGRAM_CONVERSATION"] = "1"
                                env["WRTGRAM_INPUT"] = command_text
                                
                            try:
                                output = subprocess.check_output(p_args, cwd=cwd_path, env=env, timeout=30, stderr=subprocess.STDOUT)
                                result = output.decode('utf-8')
                            except subprocess.TimeoutExpired as e:
                                result = (e.output.decode('utf-8') if e.output else "") + "\n(Command Timed Out)"
                            except subprocess.CalledProcessError as e:
                                result = e.output.decode('utf-8') if e.output else "Execution Error"
                            except Exception as e:
                                result = str(e)
                                
                            subprocess.run(["/sbin/telegram_sender", result])
                    else:
                        wrtapi.send_message(wrtapi.CHAT_ID, f"Command *{cmd}* not found!")
                        
                elif cb_obj:
                    parts = final_cmd.split("|", 1)
                    fcmd = parts[0]
                    fprms = parts[1] if len(parts) > 1 else ""
                    
                    action_base = f"/usr/lib/wrtgram/plugins/actions/{fcmd}"
                    py_action = f"{action_base}.py"
                    
                    if os.path.exists(py_action) or (os.path.exists(action_base) and os.path.isfile(action_base)):
                        cwd_path = "/usr/lib/wrtgram/plugins/actions"
                        wrtapi.log_msg("telegram_bot", f"Call Action {fcmd}")
                        parameter = re.sub(r'[&;<>|\\]+', '', fprms)
                        
                        if os.path.exists(py_action):
                            p_args = ["/usr/bin/env", "python3", py_action]
                        else:
                            p_args = [f"./{fcmd}"]
                            
                        if parameter:
                            p_args.append(parameter)
                        
                        try:
                            output = subprocess.check_output(p_args, cwd=cwd_path, timeout=30, stderr=subprocess.STDOUT)
                            result = output.decode('utf-8')
                        except Exception as e:
                            if hasattr(e, 'output') and e.output:
                                result = e.output.decode('utf-8')
                            else:
                                result = "1|Error occurred|"
                                
                        result = result.replace('^', '')
                        
                        parts = result.split("|", 2)
                        remove = parts[0].strip() if len(parts) > 0 else "0"
                        msg = parts[1].strip() if len(parts) > 1 else ""
                        keyboard = parts[2].strip() if len(parts) > 2 else ""
                        
                        wrtapi.tg_api_call("answerCallbackQuery", form_data={"callback_query_id": query_ans, "text": "Updated"})
                        
                        if remove == "1":
                            data = {
                                "chat_id": wrtapi.CHAT_ID,
                                "message_id": msg_id_ans,
                                "parse_mode": "Markdown"
                            }
                            data_url = {"text": msg}
                            if keyboard:
                                data["reply_markup"] = keyboard
                                
                            wrtapi.tg_api_call("editMessageText", form_data=data, data_urlencode=data_url)
                    else:
                        wrtapi.send_message(wrtapi.CHAT_ID, f"Command Action *{fcmd}* not found!")
                        
                elif msg_obj:
                    wrtapi.send_message(wrtapi.CHAT_ID, "Sorry,\nI only recognize *commands*.\nCommands are words beginning with a slash.\nTry it !\nSend [/start](/start) to get my commands list.")
                    
            finally:
                typing_proc.terminate()
                subprocess.run('pids=$(pgrep -f "/sbin/typing" 2>/dev/null); [ -n "$pids" ] && kill $pids 2>/dev/null', shell=True)
                
        starting = False
    except Exception as e:
        wrtapi.log_msg("telegram_bot", f"error in main loop: {e}")
        time.sleep(5)

