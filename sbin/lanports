#!/usr/bin/env python3
import sys, os, subprocess, time, re
sys.path.append("/usr/lib/wrtgram")
import wrtapi

OFFER_MAC_FILE = "/tmp/wrtgram_dhcp_offer_mac"

def get_switch_name():
    try:
        output = subprocess.check_output(["swconfig", "list"], stderr=subprocess.STDOUT).decode('utf-8')
        parts = output.split()
        if len(parts) >= 4:
            return parts[3]
    except Exception:
        pass
    return "switch0"

def get_ignored_macs():
    ignored_file = wrtapi.get_uci("wrtgram.global.ignored_macaddrs_file", "/etc/wrtgram/macaddr.ignore")
    macs = []
    if os.path.exists(ignored_file):
        try:
            with open(ignored_file, "r") as f:
                for line in f:
                    macs.append(line.strip().upper())
        except:
            pass
    return macs

def main():
    wrtapi.log_msg("lanports", "Started Python Log Monitor")
    switch = get_switch_name()
    if os.path.exists(OFFER_MAC_FILE):
        try: os.remove(OFFER_MAC_FILE)
        except: pass
        
    chat_id = wrtapi.CHAT_ID
    if not chat_id:
        wrtapi.log_msg("lanports", "My Chat ID is empty. Cannot send messages.")

    # Patterns
    re_switch_up = re.compile(rf"{switch}:\s*Port\s*(\d+)\s*is\s*up")
    re_switch_down = re.compile(rf"{switch}:\s*Port\s*(\d+)\s*is\s*down")
    re_dhcpoffer = re.compile(r"DHCPOFFER.*?(([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2})")
    re_dhcpack = re.compile(r"DHCPACK.*?(([0-9]{1,3}\.){3}[0-9]{1,3})\s+(([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2})\s+(.*)")

    proc = subprocess.Popen(["logread", "-f"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    
    try:
        for line in proc.stdout:
            # LAN Switch Port Events
            match_up = re_switch_up.search(line)
            match_down = re_switch_down.search(line)
            if match_up or match_down:
                pnum = match_up.group(1) if match_up else match_down.group(1)
                state = "up" if match_up else "down"
                time_str = time.strftime("%I:%M:%S %p")
                icon = "🟢" if state == "up" else "🔴"
                msg = f"{icon} *LAN Port Alert* {icon}\n\n*Port:* {pnum}\n*Time:* {time_str}\n*State:* {state}"
                if chat_id: wrtapi.send_message(chat_id, msg)
                continue

            # DHCP New Device Notification
            if "DHCPOFFER" in line:
                match_offer = re_dhcpoffer.search(line)
                if match_offer:
                    offer_mac = match_offer.group(1).upper()
                    with open(OFFER_MAC_FILE, "w") as f:
                        f.write(offer_mac)
                continue
                
            if "DHCPACK" in line and os.path.exists(OFFER_MAC_FILE):
                match_ack = re_dhcpack.search(line)
                if match_ack:
                    ip = match_ack.group(1)
                    macaddr = match_ack.group(3).upper()
                    name = match_ack.group(5).strip()
                    name = name.replace("*", "\\*").replace("_", "\\_")
                    if not name: name = "N/A"
                    
                    try: os.remove(OFFER_MAC_FILE)
                    except: pass
                    
                    ignored = get_ignored_macs()
                    if macaddr not in ignored:
                        time_str = time.strftime("%I:%M:%S %p")
                        msg = f"🆕 *New Device Connected* 🆕\n\n*Hostname:* {name}\n*Time:* {time_str}\n*IP Address:* {ip}\n*MAC Address:* {macaddr}"
                        if chat_id: wrtapi.send_message(chat_id, msg)
                        
    except KeyboardInterrupt:
        proc.terminate()
    except Exception as e:
        wrtapi.log_msg("lanports", f"Crash: {e}")
        proc.terminate()

if __name__ == "__main__":
    main()