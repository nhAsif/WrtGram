#!/bin/ash

export PATH='/usr/bin:/usr/sbin:/bin:/sbin'

. /usr/lib/wrtgram/common

switch=$(swconfig list | awk '{printf $4}')
OFFER_MAC_FILE="/tmp/wrtgram_dhcp_offer_mac"
rm -f "$OFFER_MAC_FILE"

(logread -f | while read -r line; do

    # ── LAN Switch Port Events ─────────────────────────────────────────────
    if echo "${line}" | grep -q "${switch}: Port"; then
        ports=$(echo "${line}" | grep -oE "Port ([0-9]+) is (up|down)")
        time=$(date +"%I:%M:%S %p")
        pnum=$(echo "${ports}" | cut -d ' ' -f 2)
        state=$(echo "${ports}" | cut -d ' ' -f 4)
        if [ "$state" = "up" ]; then
            icon="🟢"
        else
            icon="🔴"
        fi
        /sbin/telebot "$(printf "%s *LAN Port Alert* %s\n\n*Port:* %s\n*Time:* %s\n*State:* %s" \
            "$icon" "$icon" "$pnum" "$time" "$state")"
    fi

    # ── DHCP New Device Notification ──────────────────────────────────────
    # Track DHCPOFFER by MAC address rather than a fragile line countdown,
    # which eliminates the race condition on busy networks.
    if echo "${line}" | grep -q "DHCPOFFER"; then
        offer_mac=$(echo "${line}" | grep -oE "([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}" | head -1)
        [ -n "$offer_mac" ] && echo "$offer_mac" >"$OFFER_MAC_FILE"
    fi

    if echo "${line}" | grep -q "DHCPACK" && [ -f "$OFFER_MAC_FILE" ]; then
        dados=$(echo "${line}" | grep -oE \
            "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3} [0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2} .*")
        if [ -z "${dados}" ]; then
            dados=$(echo "${line}" | grep -oE \
                "[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3} [0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}")
        fi
        if [ -n "${dados}" ]; then
            time=$(date +"%I:%M:%S %p")
            ip=$(echo "${dados}" | cut -d ' ' -f 1)
            macaddr=$(echo "${dados}" | cut -d ' ' -f 2)
            name=$(echo "${dados}" | cut -d ' ' -f 3 \
                | awk '{gsub("*","\\*",$0); gsub("_","\\_",$0); printf $0}')
            [ -z "${name}" ] && name="N/A"
            rm -f "$OFFER_MAC_FILE"  # consume the tracked offer
            if ! grep -q "$macaddr" "${WRTGRAM_IGNORED_MACS}" 2>/dev/null; then
                /sbin/telebot "$(printf "🆕 *New Device Connected* 🆕\n\n*Hostname:* %s\n*Time:* %s\n*IP Address:* %s\n*MAC Address:* %s" \
                    "$name" "$time" "$ip" "$macaddr")"
            fi
        fi
    fi

done) &