#!/bin/sh

. /usr/lib/wrtgram/common

items="$1"

# POSIX-compliant log function (replaces bash-specific 'function log()' and string slicing)
log_sender() {
    _text="$*"
    _ok=$(echo "${_text}" | jsonfilter -e "$.ok" 2>/dev/null)
    if [ "${_ok}" != "true" ]; then
        log_msg "telegram_sender: API Error: ${_text}"
    fi
}

# POSIX-compliant way to set IFS to newline only
IFS='
'

count=0
full=""

# Use a standard for loop with corrected IFS
for item in $items; do
    [ -z "$item" ] && continue
    
    item_len=$(printf "%s" "$item" | wc -c)
    # 4096 is the Telegram message limit
    if [ $((count + item_len + 1)) -gt 4096 ]; then
        # Send current buffer before it exceeds limit
        response=$(tg_api_call "sendMessage" \
            -d "chat_id=${WRTGRAM_CHAT_ID}" \
            -d "parse_mode=Markdown" \
            --data-urlencode "text=${full}")
        log_sender "$response"
        full="${item}"
        count=${item_len}
    else
        if [ -z "$full" ]; then
            full="${item}"
            count=${item_len}
        else
            full="${full}
${item}"
            count=$((count + item_len + 1))
        fi
    fi
done

# Send remaining content
if [ -n "$full" ]; then
    response=$(tg_api_call "sendMessage" \
        -d "chat_id=${WRTGRAM_CHAT_ID}" \
        -d "parse_mode=Markdown" \
        --data-urlencode "text=${full}")
    log_sender "$response"
fi
