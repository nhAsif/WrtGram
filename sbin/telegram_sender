#!/bin/ash

. /usr/lib/wrtgram/common

items=$1

# POSIX-compliant log function (replaces bash-specific 'function log()' syntax)
log() {
    TEXT="$*"
    ok=$(jsonfilter -s "${TEXT}" -e "$.ok")
    message_id=$(jsonfilter -s "${TEXT}" -e "$.result.message_id")
    from=$(jsonfilter -s "${TEXT}" -e "$.result.from")
    chat=$(jsonfilter -s "${TEXT}" -e "$.result.chat")
    date=$(jsonfilter -s "${TEXT}" -e "$.result.date")
    msg=$(jsonfilter -s "${TEXT}" -e "$.result.text")
    entities=$(jsonfilter -s "${TEXT}" -e "$.result.entities[0]")
    echo "{\"ok\": ${ok},\"result\":{\"message_id\": ${message_id}, \"from\":${from}, \"chat\":${chat},\"date\": \"${date}\",\"text\": \"${msg:0:100}\",\"entities\": [${entities}]}}" \
        | logger -t "telegram_bot[$$]" -p daemon.info
}

IFS=$'\n'
count=0
full=""
for item in $items; do
    send=0
    count=$((count + ${#item} + 1))
    if [ "$count" -eq "4096" ]; then
        send=1
    elif [ "$count" -gt "4096" ]; then
        send=2
    fi
    if [ "$send" -ne "2" ]; then
        full="${full}${item}
"
    fi

    if [ "$send" -eq "1" ]; then
        response=$(tg_api_call "sendMessage" \
            -d "chat_id=${WRTGRAM_CHAT_ID}" \
            -d "parse_mode=Markdown" \
            --data-urlencode "text=${full}")
        log "$response"
        full=""
        count=0
    elif [ "$send" -eq "2" ]; then
        response=$(tg_api_call "sendMessage" \
            -d "chat_id=${WRTGRAM_CHAT_ID}" \
            -d "parse_mode=Markdown" \
            --data-urlencode "text=${full}")
        log "$response"
        full="${item}
"
        count=${#item}
    fi
done

if [ "$count" -gt "0" ]; then
    response=$(tg_api_call "sendMessage" \
        -d "chat_id=${WRTGRAM_CHAT_ID}" \
        -d "parse_mode=Markdown" \
        --data-urlencode "text=${full}")
    log "$response"
fi
