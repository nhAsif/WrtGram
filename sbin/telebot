#!/usr/bin/env python3

import sys, os
sys.path.append("/usr/lib/wrtgram")
try:
    import wrtapi
except ImportError:
    # Fallback to local import if testing without installation
    sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '../usr/lib/wrtgram')))
    import wrtapi

if len(sys.argv) > 1:
    command_new = sys.argv[1].replace("_", r"\_")
    wrtapi.send_message(wrtapi.CHAT_ID, command_new)
    wrtapi.log_msg("telebot", command_new)
