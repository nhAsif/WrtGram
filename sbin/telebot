#!/usr/bin/env python3

import sys, os, subprocess, urllib.request, urllib.parse, ssl

def get_uci(path, default=""):
    try:
        return subprocess.check_output(["uci", "-q", "get", path]).decode('utf-8').strip()
    except Exception:
        return default

URL = get_uci("wrtgram.global.url")
KEY = get_uci("wrtgram.global.key")
WRTGRAM_API = f"{URL}{KEY}" if URL and KEY else ""
CHAT_ID = get_uci("wrtgram.global.my_chat_id")
TLS_INSECURE = get_uci("wrtgram.global.tls_insecure") == "1"

ctx = ssl.create_default_context()
if TLS_INSECURE:
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

def tg_send(msg):
    if not WRTGRAM_API or not CHAT_ID: return
    data = {"chat_id": CHAT_ID, "parse_mode": "Markdown", "text": msg}
    req = urllib.request.Request(f"{WRTGRAM_API}/sendMessage", data=urllib.parse.urlencode(data).encode('utf-8'))
    try:
        urllib.request.urlopen(req, context=ctx, timeout=10)
    except Exception as e:
        pass

if len(sys.argv) > 1:
    command_new = sys.argv[1].replace("_", r"\_")
    tg_send(command_new)
    subprocess.run(["logger", "-t", f"telegram_bot[{os.getpid()}]", "-p", "daemon.info"], input=command_new.encode())
